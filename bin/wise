#!/usr/bin/env bash
# wisecraft CLI launcher. Works from a clone, a Claude Code plugin install, or a PATH symlink.
# Launcher ported from Universal Modder (bin/um), MIT, (c) 2026 Rehan and universal-modder contributors; see NOTICE.
#   wise video compile edl.json trailer.mp4 | wise qa http://127.0.0.1:5173 --persona spender | wise music-enhance trailer.mp4 --for trailer | wise board mockups.html ...
# Uses uv when available (it creates the project's .venv with Pillow and numpy on first run);
# otherwise the system python3, which then needs `pip install pillow numpy`.
set -euo pipefail
SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do
  DIR="$(cd -P "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  [[ "$SRC" != /* ]] && SRC="$DIR/$SRC"
done
ROOT="$(cd -P "$(dirname "$SRC")/.." && pwd)"
if command -v uv >/dev/null 2>&1 && [ -z "${WISE_NO_UV:-}" ]; then
  exec uv run --quiet --project "$ROOT" python -m wisecraft "$@"
fi
PY="$(command -v python3 || command -v python)"
PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m wisecraft "$@"
